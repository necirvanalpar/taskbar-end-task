// Icon, manifest and version information for EndTask.exe.
// Numeric constants are used instead of <windows.h> names so that any resource compiler works.
#include "resource.h"

IDI_APP ICON "EndTask.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST
1 24 "EndTask.manifest"

// VS_VERSION_INFO
1 VERSIONINFO
FILEVERSION     VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION  VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L    // VOS_NT_WINDOWS32
FILETYPE        0x1L        // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Taskbar End Task"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "EndTask"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "EndTask.exe"
            VALUE "ProductName",      "Taskbar End Task"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
